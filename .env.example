# انسخ هذا الملف إلى .env.local محليًا — وعلى Vercel: Settings → Environment Variables
# لا تضع قيمًا حقيقية في المستودع إطلاقًا (ملفات .env* مستثناة في .gitignore)

# إلزامي — قاعدة Turso عبر HTTP
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# إلزامي — رابط خدمة دمج الفيديو المنشورة على Vercel (مشروع merger داخل هذا المستودع)
MERGER_API_BASE=https://<merger-project>.vercel.app

# اختياري — إن ضُبط يُطلب Bearer token على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
