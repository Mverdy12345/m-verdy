# انسخ هذا الملف إلى .env محليًا (يُحمَّل يدويًا في lib/util.js)
# على Vercel: Settings → Environment Variables — لا تضع قيمًا حقيقية في المستودع إطلاقًا
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# الحدود — كلها قابلة للضبط (اختياري)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium

# محلي فقط: منفذ خادم التطوير dev-server.js
PORT=3011
